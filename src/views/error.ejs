<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Error | Giveaway</title>
</head>
<body class="dark flex flex-col items-center justify-center h-screen">
    <div class="card p-8 text-center" style="max-width: 600px;">
        <div style="background: rgba(239, 68, 68, 0.2); width: 4rem; height: 4rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-left: auto; margin-right: auto; margin-bottom: 1.5rem;">
            <i class="fa-solid fa-circle-exclamation" style="color: var(--destructive); font-size: 1.875rem;"></i>
        </div>
        <h1 style="font-size: 1.875rem; font-weight: bold; color: var(--destructive); margin-bottom: 0.5rem;">Oops!</h1>
        <p style="color: var(--muted-foreground); margin-bottom: 1.5rem;"><%= message || 'Something went wrong.' %></p>
        <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
        
        <% if (error && process.env.NODE_ENV !== 'production') { %>
            <div style="margin-top: 2rem;">
                 <button style="font-size: 0.875rem; color: var(--muted-foreground); background: transparent; border: none; cursor: pointer;" onclick="document.querySelector('.stack-trace').style.display = document.querySelector('.stack-trace').style.display === 'block' ? 'none' : 'block'">Toggle Details</button>
                 <div class="stack-trace" style="display: none; text-align: left; background: rgba(0,0,0,0.4); padding: 1rem; border-radius: 0.5rem; margin-top: 1rem; font-size: 0.75rem; font-family: monospace; color: var(--destructive); overflow-x: auto;">
                    <%= error.stack %>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>

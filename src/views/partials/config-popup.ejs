<!-- Config Settings Popup -->
<div class="config-popup-overlay" id="configPopupOverlay" onclick="closeConfigPopup(event)">
    <div class="config-popup" onclick="event.stopPropagation()">
        <div class="config-popup-header">
            <h3><i class="fa-solid fa-gear"></i> Giveaway Settings</h3>
            <button type="button" class="config-popup-close" onclick="closeConfigPopup()">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        
        <form id="configPopupForm" class="config-popup-body">
            <!-- Giveaway Type -->
            <div class="config-section">
                <label class="config-label">Giveaway Type</label>
                <div class="config-type-selector">
                    <label class="config-type-option">
                        <input type="radio" name="popupGiveawayType" value="reaction" <%= config.giveawayType === 'reaction' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-type-card">
                            <i class="fa-solid fa-face-smile"></i>
                            <span>Reaction</span>
                        </div>
                    </label>
                    <label class="config-type-option">
                        <input type="radio" name="popupGiveawayType" value="button" <%= config.giveawayType === 'button' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-type-card">
                            <i class="fa-solid fa-square"></i>
                            <span>Button</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Reaction Options -->
            <div class="config-section" id="popupReactionOptions">
                <label class="config-label">Reaction Emoji</label>
                <div class="emoji-input-group">
                    <input type="hidden" name="popupReactionEmoji" id="popupReactionEmoji" value="<%= config.reactionEmoji || '🎉' %>">
                    <button type="button" class="emoji-btn-trigger" onclick="openEmojiPicker('popupReactionEmoji', 'popupReactionEmojiPreview')">
                        <span class="emoji-preview" id="popupReactionEmojiPreview">🎉</span>
                    </button>
                    <span class="config-hint">Click to change emoji</span>
                </div>
            </div>

            <!-- Button Options -->
            <div class="config-section" id="popupButtonOptions" style="display: none;">
                <label class="config-label">Button Settings</label>
                <div class="config-input-row">
                    <input type="text" name="popupButtonName" id="popupButtonName" value="<%= config.buttonName || 'Enter Giveaway' %>" placeholder="Button text" class="config-input" oninput="updatePopupPreview()">
                    <input type="hidden" name="popupButtonEmoji" id="popupButtonEmoji" value="<%= config.buttonEmoji || '🎁' %>">
                    <button type="button" class="emoji-btn-trigger" onclick="openEmojiPicker('popupButtonEmoji', 'popupButtonEmojiPreview')">
                        <span class="emoji-preview" id="popupButtonEmojiPreview">🎁</span>
                    </button>
                </div>
                
                <label class="config-label" style="margin-top: 0.75rem;">Button Color</label>
                <div class="config-colors">
                    <label class="config-color-option">
                        <input type="radio" name="popupButtonColor" value="primary" <%= config.buttonColor === 'primary' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-color-swatch" style="background: #5865f2;"></div>
                        <span>Blue</span>
                    </label>
                    <label class="config-color-option">
                        <input type="radio" name="popupButtonColor" value="success" <%= config.buttonColor === 'success' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-color-swatch" style="background: #3ba55c;"></div>
                        <span>Green</span>
                    </label>
                    <label class="config-color-option">
                        <input type="radio" name="popupButtonColor" value="danger" <%= config.buttonColor === 'danger' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-color-swatch" style="background: #ed4245;"></div>
                        <span>Red</span>
                    </label>
                    <label class="config-color-option">
                        <input type="radio" name="popupButtonColor" value="secondary" <%= config.buttonColor === 'secondary' ? 'checked' : '' %> onchange="updatePopupPreview()">
                        <div class="config-color-swatch" style="background: #4f545c;"></div>
                        <span>Gray</span>
                    </label>
                </div>
            </div>

            <!-- Embed Settings -->
            <div class="config-section">
                <label class="config-label">Embed Color</label>
                <div class="config-color-picker">
                    <input type="color" name="popupEmbedColor" id="popupEmbedColor" value="<%= config.embedColor || '#0057ff' %>" oninput="updatePopupPreview()">
                    <span class="config-color-value" id="popupColorValue"><%= config.embedColor || '#0057ff' %></span>
                </div>
            </div>

            <div class="config-section">
                <label class="config-label">Giveaway Embed Editor</label>
                <div class="embed-config-tabs" style="margin: 0 0 0.75rem 0; border-bottom: none; gap: 0.5rem;">
                    <button type="button" class="tab-btn active" onclick="switchEmbedTab('active')" id="popup-tab-active">Active Embed</button>
                    <button type="button" class="tab-btn" onclick="switchEmbedTab('ended')" id="popup-tab-ended">Ended Embed</button>
                </div>

                <div id="active-embed-config" style="display: block;">
                    <label class="config-label">Active Title</label>
                    <input type="text" form="createForm" name="embedTitle" id="embedTitleInput" value="<%= config.embedTitle || 'New Giveaway!' %>" class="config-input" oninput="updatePreview()">

                    <label class="config-label" style="margin-top: 0.75rem;">Active Description</label>
                    <textarea form="createForm" name="embedDescription" id="embedDescriptionInput" rows="4" class="config-input" oninput="updatePreview()"><%= config.embedDescription || 'React to enter!' %></textarea>

                    <label class="config-label" style="margin-top: 0.75rem;">Active Image</label>
                    <input type="file" form="createForm" name="embedImage" id="embedImageInput" accept="image/*" class="config-input" onchange="previewImage(this, 'active')">
                </div>

                <div id="ended-embed-config" style="display: none;">
                    <label class="config-label">Ended Title</label>
                    <input type="text" form="createForm" name="endedEmbedTitle" id="endedEmbedTitleInput" value="<%= config.endedEmbedTitle || '🎉 Giveaway Ended!' %>" class="config-input" oninput="updatePreview()">

                    <label class="config-label" style="margin-top: 0.75rem;">Ended Description</label>
                    <textarea form="createForm" name="endedEmbedDescription" id="endedEmbedDescriptionInput" rows="4" class="config-input" oninput="updatePreview()"><%= config.endedEmbedDescription || 'Winner: {winners}\nPrize: {prize}' %></textarea>

                    <label class="config-label" style="margin-top: 0.75rem;">Ended Image</label>
                    <input type="file" form="createForm" name="endedEmbedImage" id="endedEmbedImageInput" accept="image/*" class="config-input" onchange="previewImage(this, 'ended')">

                    <label class="config-label" style="margin-top: 0.75rem;">End Behavior (Buttons)</label>
                    <select form="createForm" name="endBehavior" id="endBehaviorSelect" class="config-input" onchange="updatePreview()">
                        <option value="disable">Disable Buttons</option>
                        <option value="remove">Remove Buttons</option>
                        <option value="keep">Keep Buttons (Active)</option>
                    </select>
                </div>
            </div>
        </form>

        <div class="config-popup-footer">
            <span class="config-hint">Changes are tracked automatically.</span>
        </div>
    </div>
</div>

<div id="configSaveBar" class="config-savebar" role="status" aria-live="polite">
    <div class="config-savebar-text">You have unsaved giveaway settings changes.</div>
    <div class="config-savebar-actions">
        <button type="button" class="btn btn-secondary" onclick="cancelPopupChanges()">Cancel</button>
        <button type="button" class="btn btn-primary" id="configSaveButton" onclick="saveConfigSettings()">
            <i class="fa-solid fa-check"></i> Save
        </button>
    </div>
</div>

<script>
let popupBaselineState = null;
let popupHasUnsavedChanges = false;
let popupTrackingReady = false;
let popupSuppressTracking = false;
let isSavingConfig = false;

function setConfigSavingState(saving) {
    isSavingConfig = saving;
    const saveBtn = document.getElementById('configSaveButton');
    if (!saveBtn) return;
    saveBtn.disabled = saving;
    saveBtn.innerHTML = saving
        ? '<i class="fa-solid fa-spinner fa-spin"></i> Saving...'
        : '<i class="fa-solid fa-check"></i> Save';
}

function getPopupState() {
    const getChecked = (name, fallback = '') => document.querySelector(`input[name="${name}"]:checked`)?.value || fallback;
    return {
        giveawayType: getChecked('popupGiveawayType', 'reaction'),
        reactionEmoji: document.getElementById('popupReactionEmoji')?.value || '',
        buttonEmoji: document.getElementById('popupButtonEmoji')?.value || '',
        buttonName: document.getElementById('popupButtonName')?.value || '',
        buttonColor: getChecked('popupButtonColor', 'primary'),
        embedColor: document.getElementById('popupEmbedColor')?.value || '#0057ff',
        embedTitle: document.getElementById('embedTitleInput')?.value || '',
        embedDescription: document.getElementById('embedDescriptionInput')?.value || '',
        endedEmbedTitle: document.getElementById('endedEmbedTitleInput')?.value || '',
        endedEmbedDescription: document.getElementById('endedEmbedDescriptionInput')?.value || '',
        endBehavior: document.getElementById('endBehaviorSelect')?.value || 'disable',
        embedImageUrl: config.embedImage || '',
        endedEmbedImageUrl: config.endedEmbedImage || '',
        embedImageFile: document.getElementById('embedImageInput')?.files?.[0]?.name || '',
        endedEmbedImageFile: document.getElementById('endedEmbedImageInput')?.files?.[0]?.name || ''
    };
}

function setPopupState(state) {
    popupSuppressTracking = true;
    try {
        const typeInput = document.querySelector(`input[name="popupGiveawayType"][value="${state.giveawayType || 'reaction'}"]`);
        if (typeInput) typeInput.checked = true;

        const btnColorInput = document.querySelector(`input[name="popupButtonColor"][value="${state.buttonColor || 'primary'}"]`);
        if (btnColorInput) btnColorInput.checked = true;

        if (document.getElementById('popupReactionEmoji')) document.getElementById('popupReactionEmoji').value = state.reactionEmoji || '';
        if (document.getElementById('popupButtonEmoji')) document.getElementById('popupButtonEmoji').value = state.buttonEmoji || '';
        if (document.getElementById('popupButtonName')) document.getElementById('popupButtonName').value = state.buttonName || '';
        if (document.getElementById('popupEmbedColor')) document.getElementById('popupEmbedColor').value = state.embedColor || '#0057ff';
        if (document.getElementById('embedTitleInput')) document.getElementById('embedTitleInput').value = state.embedTitle || '';
        if (document.getElementById('embedDescriptionInput')) document.getElementById('embedDescriptionInput').value = state.embedDescription || '';
        if (document.getElementById('endedEmbedTitleInput')) document.getElementById('endedEmbedTitleInput').value = state.endedEmbedTitle || '';
        if (document.getElementById('endedEmbedDescriptionInput')) document.getElementById('endedEmbedDescriptionInput').value = state.endedEmbedDescription || '';
        if (document.getElementById('endBehaviorSelect')) document.getElementById('endBehaviorSelect').value = state.endBehavior || 'disable';

        // File inputs cannot restore a prior selected file; cancel discards pending file selection.
        if (document.getElementById('embedImageInput')) document.getElementById('embedImageInput').value = '';
        if (document.getElementById('endedEmbedImageInput')) document.getElementById('endedEmbedImageInput').value = '';

        if (typeof initPopupEmojis === 'function') initPopupEmojis();
        if (typeof updatePopupPreview === 'function') updatePopupPreview();
        if (typeof updatePreview === 'function') updatePreview();
    } finally {
        popupSuppressTracking = false;
    }
}

function setPopupDirty(dirty) {
    popupHasUnsavedChanges = dirty;
    const bar = document.getElementById('configSaveBar');
    if (!bar) return;

    if (dirty) {
        bar.classList.add('show');
    } else {
        bar.classList.remove('show', 'shake');
    }
}

function shakeSaveBar() {
    const bar = document.getElementById('configSaveBar');
    if (!bar) return;
    bar.classList.remove('shake');
    void bar.offsetWidth;
    bar.classList.add('shake');
}

function markPopupDirtyFromInputs() {
    if (popupSuppressTracking || !popupBaselineState) return;
    const now = getPopupState();
    const dirty = JSON.stringify(now) !== JSON.stringify(popupBaselineState);
    const becameDirty = dirty && !popupHasUnsavedChanges;
    setPopupDirty(dirty);
    if (becameDirty) shakeSaveBar();
}

function initPopupChangeTracking() {
    if (popupTrackingReady) return;
    popupTrackingReady = true;

    const trackedSelectors = [
        '#configPopupForm input',
        '#configPopupForm textarea',
        '#configPopupForm select',
        '#embedTitleInput',
        '#embedDescriptionInput',
        '#endedEmbedTitleInput',
        '#endedEmbedDescriptionInput',
        '#endBehaviorSelect',
        '#embedImageInput',
        '#endedEmbedImageInput'
    ];

    trackedSelectors.forEach((selector) => {
        document.querySelectorAll(selector).forEach((el) => {
            el.addEventListener('input', markPopupDirtyFromInputs);
            el.addEventListener('change', markPopupDirtyFromInputs);
        });
    });

    document.addEventListener('click', (e) => {
        const link = e.target.closest('a[href]');
        if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
        if (!popupHasUnsavedChanges) return;
        e.preventDefault();
        shakeSaveBar();
        alert('There are unsaved changes. Please Save or Cancel first.');
    });

    window.addEventListener('beforeunload', (e) => {
        if (!popupHasUnsavedChanges) return;
        e.preventDefault();
        e.returnValue = 'There are unsaved changes you have not saved.';
    });
}

function openConfigPopup() {
    initPopupChangeTracking();
    if (!popupBaselineState) {
        popupBaselineState = getPopupState();
    }
    document.getElementById('configPopupOverlay').classList.add('show');
    document.body.style.overflow = 'hidden';
    initPopupEmojis();
    if (typeof switchEmbedTab === 'function') {
        switchEmbedTab(window.currentTab || 'active');
    }
    updatePopupPreview();
}

function closeConfigPopup(event, forceClose = false) {
    if (event && event.target !== event.currentTarget) return;
    if (!forceClose && popupHasUnsavedChanges) {
        shakeSaveBar();
        showSnackbar('Unsaved changes. Use Save or Cancel in the bar.', 'warning');
        return;
    }
    document.getElementById('configPopupOverlay').classList.remove('show');
    document.body.style.overflow = '';
}

function cancelPopupChanges() {
    if (!popupBaselineState) {
        setPopupDirty(false);
        closeConfigPopup(null, true);
        return;
    }

    setPopupState(popupBaselineState);
    setPopupDirty(false);
    closeConfigPopup(null, true);
}

function initPopupEmojis() {
    const reactionEmoji = document.getElementById('popupReactionEmoji').value;
    const buttonEmoji = document.getElementById('popupButtonEmoji').value;
    setEmojiContent('popupReactionEmojiPreview', reactionEmoji);
    setEmojiContent('popupButtonEmojiPreview', buttonEmoji);
}

function updatePopupPreview() {
    const giveawayType = document.querySelector('input[name="popupGiveawayType"]:checked')?.value || 'reaction';
    
    // Show/hide sections
    document.getElementById('popupReactionOptions').style.display = giveawayType === 'reaction' ? 'block' : 'none';
    document.getElementById('popupButtonOptions').style.display = giveawayType === 'button' ? 'block' : 'none';
    
    // Update color value display
    const colorInput = document.getElementById('popupEmbedColor');
    document.getElementById('popupColorValue').textContent = colorInput.value;

    markPopupDirtyFromInputs();
}

function saveConfigSettings() {
    if (isSavingConfig) {
        shakeSaveBar();
        return;
    }

    const payload = {
        giveawayType: document.querySelector('input[name="popupGiveawayType"]:checked')?.value || 'reaction',
        reactionEmoji: document.getElementById('popupReactionEmoji').value,
        buttonEmoji: document.getElementById('popupButtonEmoji').value,
        buttonName: document.getElementById('popupButtonName').value,
        buttonColor: document.querySelector('input[name="popupButtonColor"]:checked')?.value || 'primary',
        embedColor: document.getElementById('popupEmbedColor').value,
        embedTitle: document.getElementById('embedTitleInput')?.value || 'New Giveaway!',
        embedDescription: document.getElementById('embedDescriptionInput')?.value || 'React to enter!',
        endedEmbedTitle: document.getElementById('endedEmbedTitleInput')?.value || '🎉 Giveaway Ended!',
        endedEmbedDescription: document.getElementById('endedEmbedDescriptionInput')?.value || 'Winner: {winners}\nPrize: {prize}',
        endBehavior: document.getElementById('endBehaviorSelect')?.value || 'disable',
        embedImage: config.embedImage || '',
        endedEmbedImage: config.endedEmbedImage || ''
    };

    const multipart = new FormData();
    Object.entries(payload).forEach(([key, value]) => multipart.append(key, value));

    const activeFile = document.getElementById('embedImageInput')?.files?.[0];
    const endedFile = document.getElementById('endedEmbedImageInput')?.files?.[0];
    if (activeFile) multipart.append('embedImage', activeFile);
    if (endedFile) multipart.append('endedEmbedImage', endedFile);

    setConfigSavingState(true);
    
    // Submit to server
    fetch('/dashboard/<%= guild.id %>/config', {
        method: 'POST',
        headers: {
            'Accept': 'application/json'
        },
        body: multipart
    })
    .then(async (r) => {
        if (!r.ok) {
            throw new Error('Failed to save settings');
        }

        const contentType = r.headers.get('content-type') || '';
        const data = contentType.includes('application/json') ? await r.json().catch(() => ({})) : {};
        if (data.success === false) {
            throw new Error('Failed to save settings');
        }

        // Server save succeeded; UI updates are handled separately to avoid false failed state.
        showSnackbar('Settings saved!', 'success');

        try {
            Object.assign(config, payload, data.config || {});
            const activeInput = document.getElementById('embedImageInput');
            const endedInput = document.getElementById('endedEmbedImageInput');
            if (activeInput) activeInput.value = '';
            if (endedInput) endedInput.value = '';
            popupBaselineState = getPopupState();
            setPopupDirty(false);
            updateMainPreview();
            if (typeof updatePreview === 'function') {
                updatePreview();
            }
            closeConfigPopup(null, true);
        } catch (uiError) {
            console.error('Saved but failed to update preview UI:', uiError);
            showSnackbar('Saved, but preview update failed. Refresh page.', 'warning');
        }
    })
    .catch(err => {
        console.error(err);
        showSnackbar('Error saving settings', 'error');
    })
    .finally(() => {
        setConfigSavingState(false);
    });
}

function updateMainPreview() {
    // Update embed color
    const embedBorder = document.querySelector('.embed-border');
    if (embedBorder) embedBorder.style.backgroundColor = config.embedColor;
    
    // Update title and description
    const titleEl = document.getElementById('previewTitle');
    const descEl = document.getElementById('previewDescription');
    if (titleEl) titleEl.textContent = config.embedTitle;
    if (descEl) descEl.textContent = config.embedDescription;
    
    // Update emoji previews
    if (config.giveawayType === 'button') {
        setEmojiContent('previewButtonEmoji', config.buttonEmoji, 20);
        const labelEl = document.getElementById('previewButtonLabel');
        if (labelEl) labelEl.textContent = config.buttonName;
    } else {
        setEmojiContent('previewReactionEmoji', config.reactionEmoji, 22);
    }
}

// Close on Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('configPopupOverlay').classList.contains('show')) {
        closeConfigPopup();
    }
});

window.markPopupDirtyFromInputs = markPopupDirtyFromInputs;
</script>

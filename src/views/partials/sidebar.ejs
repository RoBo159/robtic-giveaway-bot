
<div class="sidebar">
    <div class="flex items-center gap-2 mb-8 px-2">
        <% if (guild.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Icon" class="avatar rounded-lg w-8 h-8">
        <% } else { %>
            <div class="avatar rounded-lg w-8 h-8 bg-secondary flex items-center justify-center font-bold">
                <%= guild.name.charAt(0) %>
            </div>
        <% } %>
        <h2 class="font-bold truncate"><%= guild.name %></h2>
    </div>
    
    <div class="flex flex-col gap-1">
        <a href="/dashboard/<%= guild.id %>/config" class="sidebar-link <%= page === 'config' ? 'active' : '' %>">
            <i class="fa-solid fa-cog w-5"></i> Configuration
        </a>
        <a href="/dashboard/<%= guild.id %>/create" class="sidebar-link <%= page === 'create' ? 'active' : '' %>">
            <i class="fa-solid fa-gift w-5"></i> Create Giveaway
        </a>
        <a href="/dashboard/<%= guild.id %>/logs" class="sidebar-link <%= page === 'logs' ? 'active' : '' %>">
            <i class="fa-solid fa-list-ul w-5"></i> Giveaway Logs
        </a>
        <a href="/dashboard/<%= guild.id %>/settings" class="sidebar-link <%= page === 'settings' ? 'active' : '' %>">
            <i class="fa-solid fa-sliders w-5"></i> Settings
        </a>
    </div>

    <div class="mt-auto pt-4 border-t border-border">
        <a href="/dashboard" class="sidebar-link">
            <i class="fa-solid fa-arrow-left w-5"></i> Server List
        </a>
        <a href="/auth/logout" class="sidebar-link text-destructive hover:bg-destructive/10">
            <i class="fa-solid fa-sign-out-alt w-5"></i> Logout
        </a>
    </div>
</div>


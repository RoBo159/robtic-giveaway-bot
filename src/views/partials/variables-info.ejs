
<div class="variables-info-container">
    <button type="button" class="variables-info-btn" onclick="toggleVariablesInfo()" title="Available Variables">
        <i class="fa-solid fa-info-circle"></i>
    </button>
    <div class="variables-info-popup" id="variablesInfoPopup">
        <div class="variables-info-header">
            <h4>Available Variables</h4>
            <button type="button" class="variables-info-close" onclick="toggleVariablesInfo()">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        <div class="variables-info-content">
            <div class="variable-item">
                <code>{user}</code>
                <span>Mention the user who triggered the action</span>
            </div>
            <div class="variable-item">
                <code>{prize}</code>
                <span>The giveaway prize name</span>
            </div>
            <div class="variable-item">
                <code>{guildName}</code>
                <span>The server name</span>
            </div>
            <div class="variable-item">
                <code>{endTime}</code>
                <span>When the giveaway ends (relative time)</span>
            </div>
            <div class="variable-item">
                <code>{winners}</code>
                <span>Number of winners</span>
            </div>
            <div class="variable-item">
                <code>{emoji}</code>
                <span>The giveaway emoji (reaction or button)</span>
            </div>
            <div class="variable-item">
                <code>{#channelid}</code>
                <span>Mention a channel (replace channelid with ID)</span>
            </div>
            <div class="variable-item">
                <code>{&amp;roleid}</code>
                <span>Mention a role (replace roleid with ID)</span>
            </div>
            <div class="variable-item">
                <code>{@userid}</code>
                <span>Mention a specific user (replace userid with ID)</span>
            </div>
        </div>
    </div>
</div>

<script>
function toggleVariablesInfo() {
    const popup = document.getElementById('variablesInfoPopup');
    popup.classList.toggle('show');
}
document.addEventListener('click', (e) => {
    const container = e.target.closest('.variables-info-container');
    const popup = document.getElementById('variablesInfoPopup');
    if (!container && popup && popup.classList.contains('show')) {
        popup.classList.remove('show');
    }
});
</script>

<style>
.variables-info-container {
    position: relative;
    display: inline-block;
}

.variables-info-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--secondary);
    color: var(--muted-foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.variables-info-btn:hover {
    background: var(--accent);
    color: var(--primary);
    border-color: var(--primary);
}

.variables-info-popup {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    width: 320px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.2s ease;
}

.variables-info-popup.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.variables-info-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
}

.variables-info-header h4 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
}

.variables-info-close {
    background: none;
    border: none;
    color: var(--muted-foreground);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.variables-info-close:hover {
    color: var(--foreground);
}

.variables-info-content {
    padding: 0.75rem;
    max-height: 300px;
    overflow-y: auto;
}

.variable-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem;
    border-radius: calc(var(--radius) - 2px);
    transition: background 0.15s ease;
}

.variable-item:hover {
    background: var(--secondary);
}

.variable-item code {
    font-family: 'Fira Code', 'Monaco', monospace;
    font-size: 0.8rem;
    color: var(--primary);
    background: rgba(var(--primary-rgb), 0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    width: fit-content;
}

.variable-item span {
    font-size: 0.75rem;
    color: var(--muted-foreground);
}
</style>
